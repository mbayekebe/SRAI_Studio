{"kind":"textbox","id":"sh/xcbi14ru","slide":6,"text":"SRAI BOOK 7  |  V7_B_N15","textPreview":"SRAI BOOK 7  |  V7_B_N15","textChars":24,"textLines":1,"bbox":[58,28,520,24]}
