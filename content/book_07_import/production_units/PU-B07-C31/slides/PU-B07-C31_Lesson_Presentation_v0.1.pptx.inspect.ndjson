{"kind":"textbox","id":"sh/3i9c7at8","slide":4,"text":"High service volume is reviewed alongside outcomes, adverse events, and patient experience.","textPreview":"High service volume is reviewed alongside outcomes, adverse events, and patient experience.","textChars":91,"textLines":1,"bbox":[88,280,630,110]}
