{"kind":"textbox","id":"sh/vu5obm14","slide":4,"text":"A programme assessment separates observed change from plausible contribution.","textPreview":"A programme assessment separates observed change from plausible contribution.","textChars":77,"textLines":1,"bbox":[88,280,630,110]}
