{"kind":"textbox","id":"sh/mdcbix03","slide":6,"text":"Choose health, education, agriculture, or habitat.","textPreview":"Choose health, education, agriculture, or habitat.","textChars":50,"textLines":1,"bbox":[58,190,1050,40]}
