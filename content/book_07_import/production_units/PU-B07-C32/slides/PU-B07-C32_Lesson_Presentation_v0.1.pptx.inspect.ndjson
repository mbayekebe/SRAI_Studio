{"kind":"textbox","id":"sh/ozutk7i9","slide":6,"text":"Name the decision owner and lawful action.","textPreview":"Name the decision owner and lawful action.","textChars":42,"textLines":1,"bbox":[116,272,800,38]}
{"kind":"textbox","id":"sh/b2lcv21k","slide":6,"text":"2","textPreview":"2","textChars":1,"textLines":1,"bbox":[58,345,45,38]}
